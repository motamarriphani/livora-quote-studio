{
  "name": "livora-quote-studio",
  "version": "2.2.0",
  "private": true,
  "description": "LIVORA Quote Studio — mobile-first interior quotation builder (static frontend + Convex backend)",
  "scripts": {
    "dev": "python -m http.server 8130",
    "test": "node scripts/verify.mjs",
    "stage": "node scripts/stage-public.mjs",
    "deploy": "node scripts/stage-public.mjs && wrangler pages deploy public --project-name accounts-livora --branch main",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "web:dev": "vite --config web/vite.config.mts",
    "web:build": "vite build --config web/vite.config.mts",
    "web:test": "vitest run --config web/vite.config.mts",
    "web:typecheck": "tsc -p web/tsconfig.json"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.11",
    "convex": "^1.43.0",
    "pdfjs-dist": "^6.4.299",
    "pdfmake": "^0.3.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
