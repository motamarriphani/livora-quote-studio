{
  "name": "livora-quote-studio",
  "version": "3.0.0",
  "private": true,
  "description": "LIVORA Quote Studio — mobile-first interior quotation builder (React + Vite frontend, Convex backend, Clerk login)",
  "scripts": {
    "dev": "vite --config web/vite.config.mts",
    "build": "vite build --config web/vite.config.mts",
    "preview": "vite preview --config web/vite.config.mts",
    "test": "node scripts/verify.mjs",
    "typecheck": "tsc -p web/tsconfig.json && tsc -p convex/tsconfig.json",
    "deploy": "npm test && npm run build && wrangler pages deploy web/dist --project-name accounts-livora --branch main",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.11",
    "convex": "^1.43.0",
    "pdfjs-dist": "^6.4.299",
    "pdfmake": "^0.3.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
